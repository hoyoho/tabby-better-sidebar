msgstr "最近启动的 5 个配置，包含所有类型。"

msgid "A list shown under the active sessions."
msgstr "显示在活动会话下方的列表。"

msgid "One row per pane, not per tab."
msgstr "每个窗格一行，而非每个标签页。"

msgid "Open SSH connections, at the top of the sidebar."
msgstr "打开的 SSH 连接，位于侧边栏顶部。"

msgid "Latency probe, in seconds"
msgstr "延迟探测，单位秒"

