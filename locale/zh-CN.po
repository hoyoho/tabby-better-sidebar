msgstr "超过 25 个文件或 20 MB 时会请求确认。"

msgid "Automatic refresh, in seconds"
msgstr "自动刷新，单位秒"

msgid "Only changed entries are redrawn."
msgstr "仅重绘发生变化的条目。"

