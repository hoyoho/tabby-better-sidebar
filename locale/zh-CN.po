msgid "General"
msgstr "通用"

msgid "Features"
msgstr "功能"

msgid "Show the sidebar"
msgstr "显示侧边栏"

msgid "Removes the sidebar without uninstalling anything."
msgstr "移除侧边栏但不会卸载任何东西。"

msgid "Untick to hide it; this page stays reachable."
msgstr "取消勾选即可隐藏；此页面仍可访问。"

msgid "Hide the Tabby transfers menu"
msgstr "隐藏 Tabby 的传输菜单"

msgid "Otherwise the native Tabby menu opens on every transfer."
msgstr "否则每次传输时 Tabby 原生菜单都会弹出。"

msgid "The sidebar panel already shows the same transfers."
msgstr "侧边栏面板已经显示了相同的传输。"

msgid "Each block switches on independently. Nothing is deleted by turning one off."
msgstr "每个区块独立开关。关闭某个区块不会删除任何内容。"

msgid "Mirrors the state of Tabby port forwarding."
msgstr "镜像 Tabby 端口转发的状态。"

msgid "Port forwarding panel and badges on the profiles."
msgstr "端口转发面板以及配置上的徽标。"

msgid "Unavailable on this version of Tabby. Your setting is kept."
msgstr "此版本的 Tabby 上不可用。你的设置已保留。"

msgid "Workspaces"
msgstr "工作区"

msgid "\"All\" excludes nothing; the filter bar searches everywhere."
msgstr "“全部”不排除任何内容；过滤栏在所有位置搜索。"

msgid "Workspace bar, above the list."
msgstr "工作区栏，位于列表上方。"

msgid "Presentation"
msgstr "呈现方式"

msgid "Tabs or a compact list, as you prefer."
msgstr "标签页或紧凑列表，任你选择。"

msgid "Changes how the workspace bar is displayed."
msgstr "更改工作区栏的显示方式。"

msgid "Tabs (wrap onto new lines)"
msgstr "标签页（换行显示）"

msgid "Dropdown list"
msgstr "下拉列表"

msgid "Filter bar"
msgstr "过滤栏"

msgid "Searches the name, description, host and username."
msgstr "搜索名称、描述、主机和用户名。"

msgid "Search field and shortcut"
msgstr "搜索框和快捷键"

msgid "A library of commands attached to profiles and folders."
msgstr "附加到配置和文件夹的命令库。"

msgid "The \"Snippets\" entry of the right click and its dedicated tab."
msgstr "右键菜单中的“片段”项及其专属标签页。"

msgid "Notes"
msgstr "备注"

msgid "A free-form memo per profile or folder."
msgstr "为每个配置或文件夹保存的自由备注。"

msgid "The \"note\" entry of the right click and its badge."
msgstr "右键菜单中的“备注”项及其徽标。"

