//- Mirrors Tabby's own forwarding state, never drives it. Sits under the
//- sessions it belongs to rather than at the very bottom of the sidebar — the
//- tree below is height-constrained, and a second live-state block reads
//- better next to the first. Unlike the sessions block, this one is hidden in
//- SFTP mode: the SFTP tab has no forwarding state to show.
.active-tunnels(*ngIf='showTunnels && !sftpMode && activeTunnels.length')
    a.active-sessions-header((click)='toggleActiveTunnels()', href='#')
        .fa.fa-fw.fas.me-1(
            [class.fa-chevron-down]='!activeTunnelsCollapsed',
            [class.fa-chevron-right]='activeTunnelsCollapsed'
        )
        span.me-auto {{ 'Active tunnels' | translate }}
        span.active-sessions-count {{ activeTunnels.length }}
    div(*ngIf='!activeTunnelsCollapsed')
        //- The row shows the description the user gave the tunnel; the
        //- technical form is one click away rather than in the way. Action
        //- buttons are divs, never nested <a> — the parser un-nests those
        //- silently and breaks the row.
        ng-container(*ngFor='let tunnel of activeTunnels; let i = index')
            //- Three states, told apart by the row style rather than by
            //- presence: `waiting` is a cut session's tunnel kept visible
            //- while a reconnection is possible, `lost` one the revival did
            //- not bring back. The tooltip carries the explanation.
            a.active-tunnel(
                (click)='toggleTunnelDetails(i, $event)',
                [class.tunnel-waiting]='tunnel.state === "waiting"',
                [class.tunnel-lost]='tunnel.state === "lost"',
                [title]='tunnel.tooltip',
                href='#'
            )
                .fa.fa-fw.fas.ms-1.tunnel-icon(
                    [class.fa-link]='tunnel.state === "live"',
                    [class.fa-rotate]='tunnel.state === "waiting"',
                    [class.fa-link-slash]='tunnel.state === "lost"'
                )
                span.ms-2.me-auto.no-wrap {{ tunnel.label }}
                span.tunnel-state(*ngIf='tunnel.state === "waiting"') {{ 'resuming…' | translate }}
                span.tunnel-state(*ngIf='tunnel.state === "lost"') {{ 'not restored' | translate }}
                span.tunnel-session.no-wrap {{ tunnel.sessionName }}
                .actions
                    .action(
                        *ngIf='tunnel.url',
                        (click)='openTunnelUrl(tunnel, $event)',
                        [title]="'Open {url} in the browser' | translate:{ url: tunnel.url }"
                    )
                        .fa.fa-fw.fas.fa-arrow-up-right-from-square
                    .action(
                        (click)='focusTunnelSession(tunnel, $event)',
                        [title]="'Go to the session' | translate"
                    )
                        .fa.fa-fw.fas.fa-terminal
            //- Session name stays on the row itself, so the unfolded part
            //- only adds what the row cannot show: the technical form.
            .tunnel-details(*ngIf='expandedTunnelIndex === i')
                .no-wrap {{ tunnel.detail }}
